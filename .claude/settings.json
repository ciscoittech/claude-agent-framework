{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude-library/hooks/scripts/check_structure.sh",
            "statusMessage": "Checking framework structure...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
