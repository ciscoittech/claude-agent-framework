  "skills": {
    "launch-agent": {
      "path": ".claude/commands/launch-agent.md",
      "description": "Analyze a task and launch the optimal agent with the right model, effort, and tools",
      "allowed_tools": [
        "Agent",
        "Read",
        "Grep",
        "Glob"
      ]
    },
    "review-code": {
      "path": ".claude/commands/review-code.md",
      "description": "Review code changes for bugs, security issues, and quality",
      "allowed_tools": [
        "Read",
        "Grep",
        "Glob",
        "Agent",
        "Bash(git diff:*)",
        "Bash(gh pr diff:*)"
      ]
    },
    "generate-docs": {
      "path": ".claude/commands/generate-docs.md",
      "description": "Analyze code and generate professional documentation (api, readme, architecture, guide, changelog)",
      "allowed_tools": [
        "Read",
        "Write",
        "Edit",
        "Grep",
        "Glob",
        "Agent",
        "Bash(git log:*)",
        "Bash(git tag:*)"
      ]
    },
    "audit-practices": {
      "path": ".claude/commands/audit-practices.md",
      "description": "Audit the framework against Claude Code best practices and score compliance",
      "allowed_tools": [
        "Read",
        "Grep",
        "Glob",
        "Agent"
      ]
    },
    "validate-framework": {
      "path": ".claude/commands/validate-framework.md",
      "description": "Validate a best-practice improvement by running its experiment test suite",
      "allowed_tools": [
        "Bash(pytest:*)",
        "Bash(python3:*)",
        "Read",
        "Grep",
        "Glob"
      ]
    },
    "update-docs": {
      "path": ".claude/commands/update-docs.md",
      "description": "Fetch the latest Claude Code documentation and refresh framework context files",
      "allowed_tools": [
        "WebFetch",
        "Read",
        "Write",
        "Edit",
        "Agent"
      ]
    },
    "ingest-best-practice": {
      "path": ".claude/commands/ingest-best-practice.md",
      "description": "Ingest an Anthropic best-practice document, extract principles, and analyze gaps",
      "allowed_tools": [
        "WebFetch",
        "Read",
        "Write",
        "Agent"
      ]
    },
    "build-feature": {
      "path": ".claude/commands/build-feature.md",
      "description": "Build a framework feature end to end using the framework's own agents",
      "allowed_tools": [
        "Agent",
        "Read",
        "Write",
        "Edit",
        "Bash"
      ],
      "disable_model_invocation": true
    }
